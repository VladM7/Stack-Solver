{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%LocalAppData%\\StackSolver\\logs\\app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "LayerGeneration": {
    "MaxSolverTime": 60,
    "MaxCPSATCandidates": 2000,
    "BLFAttempts": 200,
    "MaxLayerStability": 50,
    "PerSkuTopLayerFraction": 0.5,
    "UseCpsat": false,
    "UseGreedy": true,
    "UseCpsatSolution": true,
    "UseBranchAndPrice": true
  },
  "PalletDefaults": {
    "DefaultCatalog": "International",
    "DefaultPalletName": "EUR 120x80",
    "PalletLength": 120,
    "PalletWidth": 80,
    "PalletHeight": 14.4,
    "MaxStackHeight": 180,
    "MaxStackWeight": 950,
    "OverhangMode": "MinSupportedPercent",
    "MaxSkuOverhang": 100
  }
}
