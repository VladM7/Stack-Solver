<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StackSolver.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Stack_Solver</RootNamespace>
	<EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Required so the MSIX packaging project can publish the app self-contained for the Store. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Controls\**" />
    <EmbeddedResource Remove="Controls\**" />
    <None Remove="Controls\**" />
    <Page Remove="Controls\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Compile Remove="Stack-Solver.Core\**" />
    <EmbeddedResource Remove="Stack-Solver.Core\**" />
    <None Remove="Stack-Solver.Core\**" />
    <Page Remove="Stack-Solver.Core\**" />
    <Compile Remove="Stack-Solver.Infrastructure\**" />
    <EmbeddedResource Remove="Stack-Solver.Infrastructure\**" />
    <None Remove="Stack-Solver.Infrastructure\**" />
    <Page Remove="Stack-Solver.Infrastructure\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Stack-Solver.Core\Stack-Solver.Core.csproj" />
    <ProjectReference Include="Stack-Solver.Infrastructure\Stack-Solver.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.2.1" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.2.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\stacksolver-icon-1024.png" />
    <None Remove="Assets\stacksolver-icon-256.png" />
    <None Remove="Assets\stacksolver-icon-512.png" />
    <None Remove="Assets\StackSolver.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\stacksolver-icon-1024.png" />
    <Resource Include="Assets\stacksolver-icon-256.png" />
    <Resource Include="Assets\stacksolver-icon-512.png" />
    <Resource Include="Assets\StackSolver.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\**\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Images\" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\CODEOWNERS" />
    <None Include=".github\dependabot.yml" />
    <None Include=".github\FUNDING.yml" />
    <None Include=".github\pull_request_template.md" />
    <None Include=".github\workflows\codeql.yml" />
    <None Include=".github\workflows\dependency-review.yml" />
    <None Include=".github\workflows\build-test.yml" />
    <None Include=".github\workflows\vulnerability-audit.yml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
